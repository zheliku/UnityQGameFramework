using UnityQGameFramework.Luban;
using Luban = UnityQGameFramework.Luban;
using UnityQGameFramework.Core.DataTable;
using UnityQGameFramework.Runtime;

{{namespace_with_grace_begin __namespace}}
/// <summary>
/// 数据表加载器。
/// </summary>
public partial class {{__name}} : IDataTableLoader
{
    {{~for table in __tables ~}}
{{~if table.comment != '' ~}}
    /// <summary>
    /// {{escape_comment table.comment}}
    /// </summary>
{{~else~}}
    /// <summary>
    /// 获取 {{table.name}} 数据表。
    /// </summary>
{{~end~}}
    internal {{table.full_name}} {{format_property_name __code_style table.name}} { get; private set; }
    {{~end~}}

    /// <summary>
    /// 获取生成代码的结构版本。
    /// </summary>
    string IDataTableLoader.SchemaHash
    {
        get
        {
            return "__QGF_SCHEMA_HASH__";
        }
    }
    /// <summary>
    /// 构造数据表并解析表间引用；不读取资源、不修改 DataTableComponent 登记。
    /// </summary>
    /// <param name="loader">读取指定数据文件的加载方法。</param>
    /// <returns>已完成解析的数据表。</returns>
    System.Collections.Generic.IReadOnlyList<DataTableBase> IDataTableLoader.CreateTables(System.Func<string, ByteBuf> loader)
    {
        {{~for table in __tables ~}}
        {{format_property_name __code_style table.name}} = new {{table.full_name}}(loader("{{table.output_data_file}}"));
        {{~end~}}
        ResolveRef();
        return System.Array.AsReadOnly(new DataTableBase[]
        {
        {{~for table in __tables~}}
            {{format_property_name __code_style table.name}},
        {{~end~}}
        });
    }
    
    private void ResolveRef()
    {
        {{~for table in __tables ~}}
        {{format_property_name __code_style table.name}}.ResolveRef(this);
        {{~end~}}
    }
}

{{namespace_with_grace_end __namespace}}
